# Copy this file to .env and fill in your own SMTP account details.
# Never commit or share the .env file.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-google-app-password
DEFAULT_FROM_EMAIL=WorkFlow <your-address@gmail.com>
